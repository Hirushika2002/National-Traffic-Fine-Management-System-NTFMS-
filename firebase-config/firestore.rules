rules_version = '2';

// NTFMS Firestore Security Rules
// Auth-aware: reads are public (drivers look up fines), writes require sign-in.

service cloud.firestore {
  match /databases/{database}/documents {

    // Fine Categories — public read, authenticated write
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Traffic Fines — public read (drivers look up their own fine),
    // writes (new fine, payment update) require authentication.
    match /fines/{fineId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
