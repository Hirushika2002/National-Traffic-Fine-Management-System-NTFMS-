generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  officers Officer[]
  fines    TrafficFine[]

  @@map("districts")
}

model FineCategory {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(20)
  description String  @db.VarChar(255)
  baseAmount  Decimal @map("base_amount") @db.Decimal(10, 2)

  fines TrafficFine[]

  @@map("fine_categories")
}

model Officer {
  id           Int     @id @default(autoincrement())
  badgeNo      String  @unique @map("badge_no") @db.VarChar(50)
  fullName     String  @map("full_name") @db.VarChar(255)
  phoneNo      String  @map("phone_no") @db.VarChar(15)
  station      String  @db.VarChar(100)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  districtId   Int     @map("district_id")

  district District      @relation(fields: [districtId], references: [id])
  fines     TrafficFine[]
  refreshTokens RefreshToken[]

  @@map("officers")
}

enum FineStatus {
  PENDING
  PAID
}

model TrafficFine {
  id              Int        @id @default(autoincrement())
  referenceNo     String     @unique @map("reference_no") @db.VarChar(50)
  categoryId      Int        @map("category_id")
  officerId       Int        @map("officer_id")
  districtId      Int        @map("district_id")
  vehicleNo       String     @map("vehicle_no") @db.VarChar(20)
  driverLicenseNo String     @map("driver_license_no") @db.VarChar(50)
  issueDate       DateTime   @map("issue_date")
  amount          Decimal    @db.Decimal(10, 2)
  status          FineStatus @default(PENDING)

  category FineCategory @relation(fields: [categoryId], references: [id])
  officer  Officer      @relation(fields: [officerId], references: [id])
  district District     @relation(fields: [districtId], references: [id])
  payment  Payment?

  @@map("traffic_fines")
}

model Payment {
  id             Int           @id @default(autoincrement())
  fineId         Int           @unique @map("fine_id")
  amountPaid     Decimal       @map("amount_paid") @db.Decimal(10, 2)
  paymentMethod  String        @map("payment_method") @db.VarChar(50)
  transactionRef String        @unique @map("transaction_ref") @db.VarChar(100)
  channel        PaymentChannel
  payerName      String        @map("payer_name") @db.VarChar(255)
  payerContact   String        @map("payer_contact") @db.VarChar(100)
  paidAt         DateTime      @map("paid_at")

  fine    TrafficFine @relation(fields: [fineId], references: [id])
  smsLogs SmsLog[]

  @@map("payments")
}

enum PaymentChannel {
  ANDROID
  WEB
}

model Admin {
  id           Int    @id @default(autoincrement())
  fullName     String @map("full_name") @db.VarChar(255)
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  role         String @db.VarChar(50)
  refreshTokens RefreshToken[]

  @@map("admins")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @map("token_hash") @db.VarChar(255) @unique
  userType   String   @map("user_type") @db.VarChar(16)
  admin      Admin?   @relation(fields: [adminId], references: [id])
  adminId    Int?     @map("admin_id")
  officer    Officer? @relation(fields: [officerId], references: [id])
  officerId  Int?     @map("officer_id")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)

  @@map("refresh_tokens")
}

enum SmsStatus {
  SUCCESS
  FAILED
}

model SmsLog {
  id           Int       @id @default(autoincrement())
  paymentId    Int       @map("payment_id")
  officerPhone String    @map("officer_phone") @db.VarChar(15)
  message      String    @db.Text
  status       SmsStatus
  sentAt       DateTime  @map("sent_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("sms_logs")
}
