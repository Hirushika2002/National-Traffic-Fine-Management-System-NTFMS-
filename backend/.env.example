# MySQL connection string used by Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/traffic_fine_db"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS provider: "mock" (default, logs to console) or "twilio"
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_virtual_phone_number

# Seed admin account (used only by prisma/seed.js)
SEED_ADMIN_EMAIL=admin@police.lk
SEED_ADMIN_PASSWORD=ChangeMe123!
